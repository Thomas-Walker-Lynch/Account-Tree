#!/usr/bin/env bash
# -*- mode: sh; indent-tabs-mode: nil; sh-basic-offset: 2 -*-
#
# Account-Tree_install
#
# Install Account-Tree from the directory this script is in, the project's
# consumer/Account_Tree, into /usr/local/lib/Account-Tree, where only root can
# change it. The systemd units run Account-Tree_admin under root, so the copy
# they run must be one that no other account can change.
#
# The install directory is made to hold exactly what it is to hold, owned by
# root, and nothing else: new and changed files are copied, and files no
# longer to be installed are deleted. Python's __pycache__ is left out. It
# holds:
#
#   the files of the consumer directory, Account-Tree's program
#   Account_Tree__Gate/Account_Tree__Gate·Request
#                         the request gate, from the consumer directory
#                         beside it, consumer/Account_Tree__Gate, setuid root,
#                         mode 4755: its guard and interpreter, the
#                         Request·*.py of the program, then run with root's
#                         rights
#   Man_In_Grey/          the modules of Man-In-Grey the gate's guard and
#                         interpreter, and the program's requests, import,
#                         from the project's dependency on Man-In-Grey
#
# Then system configure writes the units and the udev rule, so that they
# name the installed Account-Tree_admin.
#
# Run it under root. Whoever installs code that root runs can act as root, so
# installing is root's own work.

DIRPA__INSTALL=/usr/local/lib/Account-Tree
FILEN__GATE="Account_Tree__Gate·Request"
LIST__MAN_IN_GREY_MODULE=(Language.py Journal.py "Journal·Interface.py" Guard.py "Guard·WellFormed.py"
                          "Guard·LibraryConstraint.py" Interpreter.py Man_In_Grey.py)

usage(){
  cat <<EOF
Usage: Account-Tree_install <command>
       Account-Tree_install preview <command>
  help | -h | --help    print this message (also printed when given no arguments)
  run                   install from $(dirpa__source), with the request gate
                        and Man-In-Grey's modules, into $DIRPA__INSTALL,
                        then run Account-Tree_admin system configure
  preview run           print what run would do, change nothing
EOF
}

dirpa__source(){
  cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd
}

# the files to install, relative to the source dir, one per line
list__file(){
  ( cd "$1" && find . -name __pycache__ -prune -o -type f -print | sed 's|^\./||' | sort )
}

# mode for an installed file: programs 0755, everything else 0644
file_mode(){
  if [ -x "$1" ]; then echo 0755; else echo 0644; fi
}

# where the gate and Man-In-Grey's modules come from, given the consumer directory
dirpa__gate_source(){
  echo "$(dirname "$1")/Account_Tree__Gate"
}
dirpa__Man_In_Grey_source(){
  echo "$(dirname "$(dirname "$1")")/shared/project-dependency/Man-In-Grey/Man_In_Grey"
}

# what is to be installed, one line each: <path in the install dir> TAB <source> TAB <mode>
list__install(){
  local dirpa__source=$1 f m
  while IFS= read -r f; do
    printf '%s\t%s\t%s\n' "$f" "$dirpa__source/$f" "$(file_mode "$dirpa__source/$f")"
  done < <(list__file "$dirpa__source")
  printf '%s\t%s\t%s\n' "Account_Tree__Gate/$FILEN__GATE" "$(dirpa__gate_source "$dirpa__source")/$FILEN__GATE" 4755
  for m in "${LIST__MAN_IN_GREY_MODULE[@]}"; do
    printf '%s\t%s\t%s\n' "Man_In_Grey/$m" "$(dirpa__Man_In_Grey_source "$dirpa__source")/$m" 0644
  done
}

# why what is to be installed cannot be, or nothing
install__problem(){
  local dirpa__source=$1 target source mode
  while IFS=$'\t' read -r target source mode; do
    if [ ! -f "$source" ]; then
      case "$target" in
        Account_Tree__Gate/*) echo "no request gate at $source; build and promote the Account_Tree__Gate namespace" ;;
        Man_In_Grey/*)        echo "no $source; the project's Man-In-Grey dependency is to link Man-In-Grey's consumer/, promoted with pass 6 or later" ;;
        *)                    echo "no $source" ;;
      esac
      return
    fi
  done < <(list__install "$dirpa__source")
  # the kernel ignores the setuid bit on a file system mounted nosuid
  if findmnt -no OPTIONS -T "$(dirname "$DIRPA__INSTALL")" 2>/dev/null | tr ',' '\n' | grep -qx nosuid; then
    echo "$(dirname "$DIRPA__INSTALL") is on a file system mounted nosuid, where the request gate would not run with root's rights"
  fi
}

install_tree(){
  local preview=$1 dirpa__source=$2
  local count_of__new=0 count_of__replaced=0 count_of__deleted=0 count_of__unchanged=0
  local verb__made=made verb__new=installed verb__replaced=replaced verb__deleted=deleted
  if [ "$preview" = yes ]; then
    verb__made="would make" verb__new="would install" verb__replaced="would replace" verb__deleted="would delete"
  fi

  if [ ! -d "$DIRPA__INSTALL" ]; then
    printf '  %-16s%s\n' "$verb__made" "$DIRPA__INSTALL"
    [ "$preview" = yes ] || install -d -o root -g root -m 0755 "$DIRPA__INSTALL" || return 1
  fi

  # install sets the owner before the mode, as the owner's change would clear a
  # setuid bit set before it
  local f target source mode
  local -A set__target=()
  while IFS=$'\t' read -r target source mode; do
    set__target["$target"]=1
    if [ ! -e "$DIRPA__INSTALL/$target" ]; then
      printf '  %-16s%s\n' "$verb__new" "$target"; count_of__new=$((count_of__new + 1))
    elif ! cmp -s "$source" "$DIRPA__INSTALL/$target" || [ "$(stat -c %a "$DIRPA__INSTALL/$target")" != "${mode#0}" ] \
         || [ "$(stat -c %u:%g "$DIRPA__INSTALL/$target")" != 0:0 ]; then
      printf '  %-16s%s\n' "$verb__replaced" "$target"; count_of__replaced=$((count_of__replaced + 1))
    else
      count_of__unchanged=$((count_of__unchanged + 1)); continue
    fi
    if [ "$preview" != yes ]; then
      install -D -o root -g root -m "$mode" "$source" "$DIRPA__INSTALL/$target" || return 1
    fi
  done < <(list__install "$dirpa__source")

  # files no longer to be installed
  [ -d "$DIRPA__INSTALL" ] && while IFS= read -r f; do
    if [ -z "${set__target[$f]:-}" ]; then
      printf '  %-16s%s\n' "$verb__deleted" "$f"; count_of__deleted=$((count_of__deleted + 1))
      [ "$preview" = yes ] || rm -f -- "$DIRPA__INSTALL/$f" || return 1
    fi
  done < <(list__file "$DIRPA__INSTALL")
  [ "$preview" = yes ] || find "$DIRPA__INSTALL" -mindepth 1 -type d -empty -delete

  echo "summary:"
  printf '  %4d  %s\n' "$count_of__new" "$verb__new" "$count_of__replaced" "$verb__replaced" \
         "$count_of__deleted" "$verb__deleted" "$count_of__unchanged" "unchanged"
}

CLI(){
  if [ $# -eq 0 ] || [ "$1" = help ] || [ "$1" = -h ] || [ "$1" = --help ]; then
    usage; return 0
  fi
  local preview=no
  if [ "$1" = preview ]; then preview=yes; shift; fi
  if [ "$1" != run ] || [ $# -ne 1 ]; then
    echo "Error: unknown command '$*'; run 'Account-Tree_install help' for the commands." >&2
    return 1
  fi
  if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Account-Tree_install installs code that root runs, and must be run under root." >&2
    return 1
  fi

  local dirpa__source
  dirpa__source=$(dirpa__source) || return 1
  if [ ! -f "$dirpa__source/Account-Tree_admin" ]; then
    echo "Error: $dirpa__source holds no Account-Tree_admin; run this script from the consumer directory it was promoted to." >&2
    return 1
  fi
  if [ "$dirpa__source" = "$DIRPA__INSTALL" ]; then
    echo "Error: this is the installed copy; run the Account-Tree_install in the project's consumer directory." >&2
    return 1
  fi
  local problem
  problem=$(install__problem "$dirpa__source")
  if [ -n "$problem" ]; then
    echo "Error: $problem." >&2
    return 1
  fi

  local word=""
  [ "$preview" = yes ] && word="preview "
  echo "Account-Tree_install ${word}run   from $dirpa__source to $DIRPA__INSTALL"
  install_tree "$preview" "$dirpa__source" || return 1

  if [ "$preview" = yes ]; then
    "$DIRPA__INSTALL/Account-Tree_admin" preview system configure 2>/dev/null \
      || echo "  would run        $DIRPA__INSTALL/Account-Tree_admin system configure"
  else
    "$DIRPA__INSTALL/Account-Tree_admin" system configure
  fi
}

# run the CLI only when executed, so that another script can source the functions
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  CLI "$@"
fi
